# LifeSOS local tooling reference — the app does NOT read these at runtime.
# All API keys are entered in-app (Connections tab). The Meta token and Plaid
# client secret are encrypted with Android Keystore AES-256-GCM (BYOK); other
# connector tokens live in private app storage excluded from backups. Keep this
# file as documentation only;
# uncommented values here are never packaged into the APK by the app code.
#
# Copy to `.env` only if your local tooling (e.g. AI Studio Secrets panel)
# needs these names to exist.

# Meta Model API key for Muse Spark 1.3 cloud inference (enter in-app instead).
# META_AI_TOKEN=MY_META_AI_TOKEN

# Plaid API credentials for live bank sync (enter in-app instead).
# PLAID_CLIENT_ID=MY_PLAID_CLIENT_ID
# PLAID_SECRET=MY_PLAID_SECRET

# Facebook token / App ID for Graph API v21.0 (enter in-app instead).
# FACEBOOK_APP_ID=MY_FACEBOOK_APP_ID

# Legacy: Gemini API key. Not used by the Meta-first inference path.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
