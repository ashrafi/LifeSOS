<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Ensures that sensitive BYOK encrypted DataStore files and connector preferences
   are NEVER included in Google Drive Cloud Backups or Device-to-Device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted DataStore storing BYOK secrets -->
        <exclude domain="root" path="datastore/lifesos_secure_byok.preferences_pb" />
        <exclude domain="file" path="datastore/lifesos_secure_byok.preferences_pb" />
        <exclude domain="sharedpref" path="lifesos_real_connectors_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude secure BYOK from D2D transfers because Keystore hardware keys are device-bound -->
        <exclude domain="root" path="datastore/lifesos_secure_byok.preferences_pb" />
        <exclude domain="file" path="datastore/lifesos_secure_byok.preferences_pb" />
        <exclude domain="sharedpref" path="lifesos_real_connectors_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
